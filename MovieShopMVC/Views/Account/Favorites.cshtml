@using System.Linq
@model IEnumerable<ApplicationCore.Models.MovieCardModel>
@{
    ViewData["Title"] = "My Favorites";
}

<section class="container py-5 section-panel">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <p class="eyebrow mb-1">Saved Collection</p>
            <h2 class="fw-semibold mb-0">Favorite Movies</h2>
        </div>
        <span class="text-muted">Total: @Model.Count()</span>
    </div>

    @if (Model.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var movie in Model)
            {
                <partial name="~/Views/Shared/_MovieCard.cshtml" model="movie"/>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            You have not added any favorites yet.
        </div>
    }
</section>
