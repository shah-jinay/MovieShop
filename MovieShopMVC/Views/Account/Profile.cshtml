@model MovieShopMVC.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    var message = ViewData["ProfileMessage"] as string;
}

<section class="container py-5 section-panel">
    <div class="row">
        <div class="col-lg-6">
            <h2 class="fw-bold mb-4">Profile</h2>
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-success" role="alert">
                    @message
                </div>
            }
            <form asp-action="Profile" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id"/>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control"/>
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control"/>
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>
                <div class="mt-3">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control"/>
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                <div class="mt-3">
                    <label asp-for="DateOfBirth" class="form-label"></label>
                    <input asp-for="DateOfBirth" class="form-control"/>
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
                <div class="mt-3">
                    <label class="form-label">Email</label>
                    <input value="@Model.Email" class="form-control" disabled/>
                </div>
                <button type="submit" class="btn btn-gradient mt-4">Save Changes</button>
            </form>
        </div>
    </div>
</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial"/>
}
