@using System.Linq
@model IEnumerable<ApplicationCore.Models.PurchasedMovieModel>
@{
    ViewData["Title"] = "My Purchases";
}

<section class="container py-5 section-panel">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <p class="eyebrow mb-1">Owned Titles</p>
            <h2 class="fw-semibold mb-0">Purchase History</h2>
        </div>
        <span class="text-muted">Total: @Model.Count()</span>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-lg-6">
                    <div class="details-card h-100">
                        <div class="d-flex gap-3 align-items-center">
                            <div class="purchase-poster">
                                <img src="@item.Movie.PosterURL" alt="@item.Movie.Title" class="img-fluid rounded">
                            </div>
                            <div>
                                <h5 class="mb-1">@item.Movie.Title</h5>
                                <p class="mb-2 text-muted">Purchased on @item.PurchaseDateTime.ToString("MMM dd, yyyy")</p>
                                <p class="mb-0 fw-semibold">$@item.TotalPrice</p>
                                <small class="text-muted">Order: @item.PurchaseNumber</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            You have not purchased any movies yet.
        </div>
    }
</section>
