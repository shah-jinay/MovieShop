@{
    ViewData["Title"] = "Create Movie";
}

<section class="container py-5 section-panel">
    <div class="row">
        <div class="col-lg-6">
            <h2 class="fw-bold mb-3">Create Movie</h2>
            <p class="text-muted">Admin movie creation workflow coming soon. Use this space to manage catalog entries.</p>
            <form class="auth-form">
                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input class="form-control" placeholder="Movie title" disabled>
                </div>
                <div class="mb-3">
                    <label class="form-label">Overview</label>
                    <textarea class="form-control" rows="4" placeholder="Synopsis" disabled></textarea>
                </div>
                <button class="btn btn-gradient" type="button" disabled>Save (coming soon)</button>
            </form>
        </div>
    </div>
</section>
