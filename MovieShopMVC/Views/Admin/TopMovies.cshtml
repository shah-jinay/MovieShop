@using System.Linq
@model IEnumerable<ApplicationCore.Models.MovieCardModel>
@{
    ViewData["Title"] = "Admin Top Movies";
}

<section class="container py-5 section-panel">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <p class="eyebrow mb-1">Admin Overview</p>
            <h2 class="fw-semibold mb-0">Top 20 Grossing Movies</h2>
        </div>
        <span class="text-muted">Total: @Model.Count()</span>
    </div>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @foreach (var movie in Model)
        {
            <partial name="~/Views/Shared/_MovieCard.cshtml" model="movie"/>
        }
    </div>
</section>
